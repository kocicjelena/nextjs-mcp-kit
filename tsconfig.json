{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // dist/ is build output — type-checking it would double-report every error in
  // src/ and fail on the emitted .d.ts files.
  //
  // example/ is a separate app with its own package.json, tsconfig and
  // node_modules. It imports the package by NAME ('nextjs-mcp-kit/components'),
  // which cannot resolve from inside the package's own tree — that is the point
  // of it, and why it must be checked from its own root, not this one.
  "exclude": ["node_modules", "dist", "cli", "example"]
}
