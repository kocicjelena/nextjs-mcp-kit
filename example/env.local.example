# Copy to .env.local. Every one of these is optional.

# Ollama's default port. Leave as-is if Ollama runs locally.
OLLAMA_API_URL=http://localhost:11434

# Empty is a SUPPORTED mode, not a broken one: the picker shows Claude as
# unavailable with the reason, and Ollama still works.
ANTHROPIC_API_KEY=

# Where instruction presets are persisted. Defaults to ./.data
# On serverless hosts set this to /tmp/nextjs-mcp-kit — their filesystem is
# read-only apart from /tmp.
NEXTJS_MCP_DATA_DIR=
